{
	"info": {
		"_postman_id": "efap-fastapi-29-modules",
		"name": "FastAPI 29 Modules Enterprise Platform",
		"description": "Complete Postman collection for testing all 29 FastAPI modules.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Authentication & Security",
			"item": [
				{
					"name": "Register User",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"newuser@company-a.com\",\n  \"password\": \"pass123\",\n  \"full_name\": \"New User\",\n  \"phone\": \"9998887776\",\n  \"tenant_domain\": \"company-a.com\"\n}"
						},
						"url": { "raw": "{{base_url}}/api/auth/register", "host": ["{{base_url}}"], "path": ["api", "auth", "register"] }
					}
				},
				{
					"name": "Login Admin User",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"admin@company-a.com\",\n  \"password\": \"admin123\"\n}"
						},
						"url": { "raw": "{{base_url}}/api/auth/login", "host": ["{{base_url}}"], "path": ["api", "auth", "login"] }
					}
				},
				{
					"name": "Get Current User",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{access_token}}" }
						],
						"url": { "raw": "{{base_url}}/api/auth/me", "host": ["{{base_url}}"], "path": ["api", "auth", "me"] }
					}
				},
				{
					"name": "Logout (Token Blacklist)",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{access_token}}" }
						],
						"url": { "raw": "{{base_url}}/api/auth/logout", "host": ["{{base_url}}"], "path": ["api", "auth", "logout"] }
					}
				},
				{
					"name": "Request OTP",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"identifier\": \"admin@company-a.com\"\n}"
						},
						"url": { "raw": "{{base_url}}/api/auth/otp/request", "host": ["{{base_url}}"], "path": ["api", "auth", "otp", "request"] }
					}
				}
			]
		},
		{
			"name": "Customer Management Modules",
			"item": [
				{
					"name": "Module 1 - API v1 Customer",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{access_token}}" }
						],
						"url": { "raw": "{{base_url}}/api/v1/customers/{{customer_id}}", "host": ["{{base_url}}"], "path": ["api", "v1", "customers", "{{customer_id}}"] }
					}
				},
				{
					"name": "Module 1 - API v2 Customer",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{access_token}}" }
						],
						"url": { "raw": "{{base_url}}/api/v2/customers/{{customer_id}}", "host": ["{{base_url}}"], "path": ["api", "v2", "customers", "{{customer_id}}"] }
					}
				},
				{
					"name": "Module 3 - Dynamic Filtering",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{access_token}}" }
						],
						"url": { "raw": "{{base_url}}/api/customers?age__gte=20&name__startswith=Th", "host": ["{{base_url}}"], "path": ["api", "customers"], "query": [{ "key": "age__gte", "value": "20" }, { "key": "name__startswith", "value": "Th" }] }
					}
				},
				{
					"name": "Module 4 - Advanced Search",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{access_token}}" }
						],
						"url": { "raw": "{{base_url}}/api/customers/search?q=tharun&page=1&limit=10&sort_by=name&sort_order=asc", "host": ["{{base_url}}"], "path": ["api", "customers", "search"] }
					}
				},
				{
					"name": "Module 5 - Bulk Create",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{access_token}}" },
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"customers\": [\n    { \"name\": \"Bulk One\", \"email\": \"b1@company-a.com\" },\n    { \"name\": \"Bulk Two\", \"email\": \"b2@company-a.com\" }\n  ]\n}"
						},
						"url": { "raw": "{{base_url}}/api/customers/bulk", "host": ["{{base_url}}"], "path": ["api", "customers", "bulk"] }
					}
				},
				{
					"name": "Module 6 - Check Duplicate",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{access_token}}" },
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"tharun@company-a.com\"\n}"
						},
						"url": { "raw": "{{base_url}}/api/customers/check-duplicate", "host": ["{{base_url}}"], "path": ["api", "customers", "check-duplicate"] }
					}
				},
				{
					"name": "Module 8 - Export Customers CSV",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{access_token}}" }
						],
						"url": { "raw": "{{base_url}}/api/customers/export", "host": ["{{base_url}}"], "path": ["api", "customers", "export"] }
					}
				},
				{
					"name": "Module 16 - Version History",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{access_token}}" }
						],
						"url": { "raw": "{{base_url}}/api/customers/{{customer_id}}/history", "host": ["{{base_url}}"], "path": ["api", "customers", "{{customer_id}}", "history"] }
					}
				}
			]
		},

						"method": "POST",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{access_token}}" },
							{ "key": "Idempotency-Key", "value": "postman-unique-key-100" },
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"amount\": 299.50,\n  \"description\": \"Idempotent Subscription Purchase\"\n}"

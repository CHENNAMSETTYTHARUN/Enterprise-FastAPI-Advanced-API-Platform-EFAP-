							{ "key": "Authorization", "value": "Bearer {{access_token}}" },
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"resource_id\": \"conference_room_a\",\n  \"booking_time\": \"2026-08-11T15:00:00Z\"\n}"

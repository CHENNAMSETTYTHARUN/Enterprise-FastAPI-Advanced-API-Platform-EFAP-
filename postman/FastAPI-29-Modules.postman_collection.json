							{ "key": "Authorization", "value": "Bearer {{access_token}}" },
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"task_name\": \"Generate Yearly Report\",\n  \"payload\": \"format=pdf&year=2026\"\n}"
